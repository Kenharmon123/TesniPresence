# Tesni Agents Edge Function that receives lead forms. Deployed with verify_jwt=false
# because this is a static site posting FormData with no Authorization header.
# The function allow-lists origins, resolves the tenant from the `domain` field,
# and re-checks the honeypot and submit timing server-side.
PUBLIC_LEAD_ENDPOINT=https://tqbvhikiicrkcegqyqtd.supabase.co/functions/v1/capture-lead

# Optional: per-domain analytics identifier, for example G-XXXXXXXXXX or GTM-XXXXXXX.
PUBLIC_GA_ID=
