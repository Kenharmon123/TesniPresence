---
import BaseLayout from '../layouts/BaseLayout.astro'; import { activeDomain } from '../config/domains'; import { generalFaqs } from '../data/tesni'; import { breadcrumbs, faqPage } from '../lib/schema';
---
<BaseLayout title={`${activeDomain.copy.faqTitle} | ${activeDomain.siteName}`} description={activeDomain.copy.faqDescription} path="/faq" jsonLd={[breadcrumbs([['Home','/'],['FAQ','/faq']]),faqPage(generalFaqs)]}><section class="section faq"><div class="wrap"><h1>{activeDomain.copy.faqH1}</h1><p class="lead">{activeDomain.copy.faqLead} {activeDomain.siteName}.</p>{generalFaqs.map(({q,a})=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section></BaseLayout>
