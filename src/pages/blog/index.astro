---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { activeDomain } from '../../config/domains'; import { getPublishedArticles } from '../../lib/content'; import { breadcrumbs } from '../../lib/schema';
const articles = await getPublishedArticles(); const pageSize=6; const page=articles.slice(0,pageSize);
---
<BaseLayout title={`${activeDomain.siteName} ${activeDomain.copy.blogTitle}`} description={activeDomain.copy.blogDescription} path="/blog" jsonLd={[breadcrumbs([['Home','/'],['Blog','/blog']])]}><section class="section"><div class="wrap"><p class="eyebrow">Insights</p><h1>{activeDomain.copy.blogH1}</h1><p class="lead">{activeDomain.copy.blogLead}</p><div class="article-list">{page.map((article)=><article><p class="eyebrow">{article.campaignName ?? 'Insights'}</p><h2><a href={`/blog/${article.slug}`}>{article.title}</a></h2><p>{article.summary}</p><p class="meta">{new Date(article.publishedAt).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})} · {Math.max(1,Math.ceil(article.body.split(/\s+/).length/220))} min read</p><a href={`/blog/${article.slug}`}>Read article →</a></article>)}</div>{articles.length>pageSize && <p><a href="/blog/page/2">Older articles →</a></p>}</div></section></BaseLayout>
