---
import BaseLayout from '../layouts/BaseLayout.astro'; import { activeDomain } from '../config/domains';
---
<BaseLayout title={`Page Not Found | ${activeDomain.siteName}`} description="The page you are looking for is not available." path="/404" noindex><section class="section"><div class="wrap"><h1>Page not found</h1><p class="lead">The page you are looking for does not exist or has moved.</p><p><a class="button" href="/">Return to homepage</a></p></div></section></BaseLayout>
