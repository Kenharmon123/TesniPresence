---
import { activeDomain } from '../config/domains';
// Default to the live Tesni Agents endpoint so a missing env var in any one of the
// four Vercel projects cannot silently turn the form into a no-op. Override with
// PUBLIC_LEAD_ENDPOINT for staging or a self-hosted Agents instance.
const LEAD_ENDPOINT_DEFAULT = 'https://tqbvhikiicrkcegqyqtd.supabase.co/functions/v1/capture-lead';
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT || LEAD_ENDPOINT_DEFAULT;
const action = endpoint;
const formId = Astro.props.formId ?? 'lead-form';
const copy = activeDomain.copy;
---
<form id={formId} class="lead-form surface" action={action} method="post" novalidate data-lead-form>
  <input type="hidden" name="domain" value={activeDomain.domain} /><input type="hidden" name="started_at" value="" data-started-at />
  <div class="honeypot" aria-hidden="true"><label>Leave this field empty <input tabindex="-1" autocomplete="off" name="company_website" /></label></div>
  <h2>{copy.formHeading}</h2><p class="muted">{copy.formNote}</p>
  <div class="form-grid"><label>Full name <input name="name" autocomplete="name" required /></label><label>Business name <input name="business" autocomplete="organization" /></label><label>Email <input name="email" autocomplete="email" type="email" required /></label><label>Phone <input name="phone" autocomplete="tel" type="tel" /></label></div>
  <label>{copy.interestLabel}<select name="interest">{copy.interestOptions.map((o) => <option>{o}</option>)}</select></label>
  <label>{copy.messageLabel} <textarea name="message" rows="5" required></textarea></label>
  <p class="form-status" aria-live="polite"></p><button class="button" type="submit">Send message</button>
  <p class="fine-print">{activeDomain.legalDisclaimer}</p>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    const started = form.querySelector<HTMLInputElement>('[data-started-at]'); if (started) started.value = String(Date.now());
    form.addEventListener('submit', async (event) => {
      const status = form.querySelector<HTMLElement>('.form-status'); const honey = form.elements.namedItem('company_website') as HTMLInputElement | null;
      if (honey?.value || (started && Date.now() - Number(started.value) < 1200)) { event.preventDefault(); if (status) status.textContent = 'Please wait a moment and try again.'; return; }
      if (!form.checkValidity()) { event.preventDefault(); form.reportValidity(); if (status) status.textContent = 'Please correct the highlighted fields.'; return; }
      const action = form.getAttribute('action') ?? ''; if (!/^https?:\/\//.test(action)) return;
      event.preventDefault(); if (status) status.textContent = 'Sending your message…';
      try { const response = await fetch(action, { method:'POST', body:new FormData(form), headers:{Accept:'application/json'} }); if (!response.ok) throw new Error('Request failed'); form.reset(); if (status) status.textContent = 'Thank you. We received your message and will be in touch.'; }
      catch { if (status) status.textContent = 'We could not send your message. Please use the email address above.'; }
    });
  });
</script>
