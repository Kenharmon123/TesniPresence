---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { activeDomain, absoluteUrl } from '../../config/domains'; import { getPodcastEpisodes } from '../../lib/content'; import { articleSchema, breadcrumbs } from '../../lib/schema';
export async function getStaticPaths(){const episodes=await getPodcastEpisodes();return episodes.map((episode)=>({params:{slug:episode.slug},props:{episode}}));}
const { episode }=Astro.props;const path=`/podcast/${episode.slug}`;const audio=episode.payload.audio_url ?? episode.mediaUrls[0];
---
<BaseLayout title={`${episode.title} | ${activeDomain.siteName} Podcast`} description={episode.summary} {path} type="article" publishedTime={episode.publishedAt} modifiedTime={episode.updatedAt} jsonLd={[breadcrumbs([['Home','/'],['Podcast','/podcast'],[episode.title,path]]),articleSchema(episode.title,episode.summary,path,episode.publishedAt,episode.updatedAt)]}><article class="prose"><p class="eyebrow">Podcast episode</p><h1>{episode.title}</h1><p>{episode.summary}</p>{audio&&<audio controls preload="metadata"><source src={audio} type={episode.payload.audio_type ?? 'audio/mpeg'} />Your browser does not support audio playback.</audio>}<h2>Show notes</h2><p>{episode.payload.show_notes ?? episode.body}</p>{episode.payload.transcript&&<section><h2>Transcript</h2><p>{episode.payload.transcript}</p></section>}<p><a href={absoluteUrl('/podcast.xml')}>Subscribe using the podcast feed</a></p></article></BaseLayout>
