---
import BaseLayout from '../layouts/BaseLayout.astro'; import { activeDomain } from '../config/domains'; import { services, generalFaqs } from '../data/tesni'; import { faqPage, breadcrumbs } from '../lib/schema';
const title = activeDomain.domain === 'tesnillc.com' ? 'Tesni, LLC | SBA Loans, Business Lines of Credit & CRE Financing' : `${activeDomain.siteName} | ${activeDomain.tagline}`;
---
<BaseLayout {title} description={activeDomain.description} jsonLd={[breadcrumbs([['Home','/']]),faqPage(generalFaqs.slice(0,5))]}><section class="hero"><div class="wrap"><p class="eyebrow">{activeDomain.tagline}</p><h1>{activeDomain.domain === 'tesnillc.com' ? 'Compare SBA Loans, Lines of Credit, and Commercial Real Estate Financing for Your Business' : activeDomain.description}</h1><p class="lead">{activeDomain.domain === 'tesnillc.com' ? 'Tesni, LLC is a U.S. business lending marketplace. We help business owners and real estate investors compare offers from SBA-preferred lenders, banks, credit unions, Certified Development Companies, and DSCR specialists. We are not a direct lender.' : activeDomain.tagline}</p><div class="actions"><a class="button" href="/contact">Request a consultation</a><a class="button secondary" href="/services">Explore services</a></div></div></section><section class="section"><div class="wrap"><h2>{activeDomain.copy.homeProgramsH2}</h2><p>{activeDomain.copy.homeProgramsIntro}</p><div class="grid three">{services.map((service)=><article class="card"><h3><a href={`/services/${service.slug}`}>{service.name}</a></h3><p>{service.description}</p><a href={`/services/${service.slug}`}>Learn more →</a></article>)}</div></div></section><section class="section muted"><div class="wrap"><h2>How {activeDomain.siteName} works</h2><div class="grid three"><article class="card"><h3>1. Brief us on your project</h3><p>Share the use of funds, timeline, and a snapshot of business and personal financials. No hard credit pull is required at this stage.</p></article><article class="card"><h3>2. We package and submit</h3><p>We assemble an underwriter-ready file and submit it to lenders most likely to offer competitive terms for your project.</p></article><article class="card"><h3>3. Compare offers and close</h3><p>Compare term sheets side by side, ask questions, and choose the structure that fits. The lender issues the final approval and closes the loan.</p></article></div></div></section><section class="section faq"><div class="wrap"><h2>Frequently asked questions</h2>{generalFaqs.slice(0,5).map(({q,a})=><details><summary>{q}</summary><p>{a}</p></details>)}<p><a href="/faq">See the full FAQ →</a></p></div></section></BaseLayout>
