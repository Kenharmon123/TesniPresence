# Required: chooses the static site build. One codebase is deployed separately per domain.
PUBLIC_TESNI_DOMAIN=tesnillc.com

# Optional: public read-only Agents Supabase project values, used only at build time.
# The anon key is intentionally public and must be protected by RLS/public read-only views.
# Never put a Supabase service-role key in this project or any browser-visible variable.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Tesni Agents Edge Function endpoint that receives lead forms.
PUBLIC_LEAD_ENDPOINT=https://your-project.supabase.co/functions/v1/capture-lead

# Optional: per-domain analytics identifier, for example G-XXXXXXXXXX or GTM-XXXXXXX.
PUBLIC_GA_ID=
