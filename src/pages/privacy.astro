---
import BaseLayout from '../layouts/BaseLayout.astro'; import { activeDomain } from '../config/domains'; import { breadcrumbs } from '../lib/schema';
---
<BaseLayout title={`Privacy Policy | ${activeDomain.siteName}`} description={`How ${activeDomain.siteName} collects, uses, and protects visitor information.`} path="/privacy" jsonLd={[breadcrumbs([['Home','/'],['Privacy Policy','/privacy']])]}><article class="prose"><h1>Privacy Policy</h1><p>This Privacy Policy describes how {activeDomain.siteName} collects, uses, and shares information about visitors and applicants who request services. By using this site you agree to the practices described in this policy.</p><h2>Information we collect</h2><p>We collect information you submit through forms, information collected automatically such as browser and pages visited, and information from third parties during the underwriting process when you authorize us to share your file.</p><h2>How we use information</h2><p>We use submitted information to {activeDomain.copy.privacyPurpose}. We use site analytics to improve site performance and content.</p><h2>{activeDomain.copy.privacySharingH2}</h2><p>{activeDomain.copy.privacySharingBody} We do not sell information to advertisers.</p><h2>Your choices</h2><p>You may request access to or deletion of your information by emailing <a href={`mailto:${activeDomain.contact.email}`}>{activeDomain.contact.email}</a>.</p></article></BaseLayout>
