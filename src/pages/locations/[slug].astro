---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { locations, services } from '../../data/tesni'; import { activeDomain } from '../../config/domains'; import { breadcrumbs } from '../../lib/schema';
export function getStaticPaths(){return locations.map((location)=>({params:{slug:location.slug},props:{location}}));}
const { location } = Astro.props; const path = `/locations/${location.slug}`;
---
<BaseLayout title={`${activeDomain.copy.locationTitlePrefix} ${location.city}, ${location.stateCode} | ${activeDomain.siteName}`} description={`${activeDomain.copy.locationDescription} ${location.city}, ${location.state} business owners and real estate investors.`} {path} jsonLd={[breadcrumbs([['Home','/'],['Locations','/locations'],[`${location.city}, ${location.stateCode}`,path]])]}><article class="prose"><p class="eyebrow">{activeDomain.copy.locationEyebrow}</p><h1>{activeDomain.copy.locationH1} {location.city}, {location.state}</h1><p>{location.blurb}</p><h2>Programs we help {location.city} owners compare</h2><ul>{services.map((service)=><li><a href={`/services/${service.slug}`}>{service.name}</a> — {service.description}</li>)}</ul><h2>{activeDomain.copy.industriesHeading} {location.city}</h2><ul>{location.industries.map((industry:string)=><li>{industry}</li>)}</ul><p class="fine-print">{activeDomain.legalDisclaimer}</p><p><a class="button" href="/contact">Talk to {activeDomain.siteName} about a {location.city} project</a></p></article></BaseLayout>
