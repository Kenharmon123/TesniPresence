---
import BaseLayout from '../layouts/BaseLayout.astro'; import { activeDomain } from '../config/domains'; import { breadcrumbs } from '../lib/schema';
const copy = activeDomain.domain === 'tesnillc.com' ? ['About Tesni, LLC','Tesni, LLC is a U.S. business lending marketplace and broker. We connect business owners and real estate investors with SBA-preferred lenders, banks, credit unions, Certified Development Companies, and DSCR specialists. Our role is to package an underwriter-ready file, route it to lenders most likely to issue competitive terms, and help borrowers compare offers side by side.','We focus on SBA 7(a) and 504 loans, business lines of credit, commercial real estate financing, DSCR rental loans, and real estate investment loans. We are not a direct lender. We do not approve loans, fund loans, or set interest rates.'] : [`About ${activeDomain.siteName}`,activeDomain.description,activeDomain.legalDisclaimer];
---
<BaseLayout title={`${copy[0]} | ${activeDomain.siteName}`} description={activeDomain.description} path="/about" jsonLd={[breadcrumbs([['Home','/'],['About','/about']])]}><article class="prose"><h1>{copy[0]}</h1><p>{copy[1]}</p><h2>Our role</h2><p>{copy[2]}</p><p><a class="button" href="/contact">Talk to us about your project</a></p></article></BaseLayout>
