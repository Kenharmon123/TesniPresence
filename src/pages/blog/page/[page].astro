---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import { getPublishedArticles } from '../../../lib/content'; import { breadcrumbs } from '../../../lib/schema'; import { activeDomain } from '../../../config/domains';
export async function getStaticPaths(){const articles=await getPublishedArticles();const pages=Math.ceil(articles.length/6);return Array.from({length:Math.max(0,pages-1)},(_,index)=>({params:{page:String(index+2)}}));}
const pageNumber=Number(Astro.params.page);const articles=await getPublishedArticles();const page=articles.slice((pageNumber-1)*6,pageNumber*6);
---
<BaseLayout title={`Business lending articles — Page ${pageNumber} | ${activeDomain.siteName}`} description="Practical business lending articles." path={`/blog/page/${pageNumber}`} jsonLd={[breadcrumbs([['Home','/'],['Blog','/blog'],[`Page ${pageNumber}`,`/blog/page/${pageNumber}`]])]}><section class="section"><div class="wrap"><h1>{activeDomain.copy.blogH1}</h1><div class="article-list">{page.map((article)=><article><h2><a href={`/blog/${article.slug}`}>{article.title}</a></h2><p>{article.summary}</p><a href={`/blog/${article.slug}`}>Read article →</a></article>)}</div><p>{pageNumber>2&&<a href={`/blog/page/${pageNumber-1}`}>Newer articles</a>} {pageNumber>2&&' · '}<a href="/blog">Back to blog</a> {articles.length>pageNumber*6&&' · '} {articles.length>pageNumber*6&&<a href={`/blog/page/${pageNumber+1}`}>Older articles</a>}</p></div></section></BaseLayout>
