---
import BaseLayout from '../layouts/BaseLayout.astro'; import { activeDomain } from '../config/domains'; import { breadcrumbs } from '../lib/schema';
---
<BaseLayout title={`Terms of Service | ${activeDomain.siteName}`} description={`Terms governing use of ${activeDomain.domain} and ${activeDomain.siteName} services.`} path="/terms" jsonLd={[breadcrumbs([['Home','/'],['Terms of Service','/terms']])]}><article class="prose"><h1>Terms of Service</h1><p>These Terms of Service govern your use of {activeDomain.domain} and the services offered by {activeDomain.siteName}. By using this site you agree to these Terms.</p><h2>Marketplace, not a direct lender</h2><p>{activeDomain.legalDisclaimer}</p><h2>No financial, legal, or tax advice</h2><p>Information published on this site is for general informational purposes only and does not constitute financial, legal, or tax advice. Consult licensed professionals for advice on your specific situation.</p><h2>Use of forms</h2><p>Submitting a contact form authorizes us to contact you about your inquiry. Submitting a contact form does not constitute an application for credit and does not authorize a hard credit pull.</p></article></BaseLayout>
