---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { locations } from '../../data/tesni'; import { breadcrumbs } from '../../lib/schema'; import { activeDomain } from '../../config/domains';
---
<BaseLayout title={`${activeDomain.siteName} ${activeDomain.copy.locationsTitle} | Cities We Serve`} description={activeDomain.copy.locationsDescription} path="/locations" jsonLd={[breadcrumbs([['Home','/'],['Locations','/locations']])]}><section class="section"><div class="wrap"><p class="eyebrow">Locations</p><h1>Cities & markets we serve</h1><p class="lead">{activeDomain.siteName} {activeDomain.copy.locationsLead}</p><div class="grid three">{locations.map((location)=><article class="card"><h2><a href={`/locations/${location.slug}`}>{location.city}, {location.stateCode}</a></h2><p>{location.blurb}</p><a href={`/locations/${location.slug}`}>{activeDomain.copy.locationLinkPrefix} {location.city} →</a></article>)}</div></div></section></BaseLayout>
