---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { services } from '../../data/tesni'; import { activeDomain } from '../../config/domains'; import { breadcrumbs } from '../../lib/schema';
---
<BaseLayout title={`${activeDomain.copy.servicesTitle} | ${activeDomain.siteName}`} description={activeDomain.copy.servicesDescription} path="/services" jsonLd={[breadcrumbs([['Home','/'],['Services','/services']])]}><section class="section"><div class="wrap"><p class="eyebrow">Services</p><h1>{activeDomain.copy.servicesH1}</h1><p class="lead">{activeDomain.copy.servicesLead}</p><div class="grid two">{services.map((service)=><article class="card"><h2><a href={`/services/${service.slug}`}>{service.name}</a></h2><p>{service.description}</p><a href={`/services/${service.slug}`}>Learn more →</a></article>)}</div></div></section></BaseLayout>
