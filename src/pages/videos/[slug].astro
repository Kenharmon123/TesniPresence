---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { activeDomain } from '../../config/domains'; import { getVideos } from '../../lib/content'; import { articleSchema, breadcrumbs } from '../../lib/schema';
export async function getStaticPaths(){const videos=await getVideos();return videos.map((video)=>({params:{slug:video.slug},props:{video}}));}
const { video }=Astro.props;const path=`/videos/${video.slug}`;
---
<BaseLayout title={`${video.title} | ${activeDomain.siteName}`} description={video.summary} {path} type="article" publishedTime={video.publishedAt} modifiedTime={video.updatedAt} jsonLd={[breadcrumbs([['Home','/'],['Videos','/videos'],[video.title,path]]),articleSchema(video.title,video.summary,path,video.publishedAt,video.updatedAt)]}><article class="prose"><p class="eyebrow">Video</p><h1>{video.title}</h1><p class="lead">{video.summary}</p>{video.payload.rendered_url ? <video controls width="720"><source src={video.payload.rendered_url} />Your browser does not support video playback.</video> : <section class="surface"><h2>{video.payload.hook}</h2><p>Video production is in progress. Read the approved script below.</p></section>}<h2>Script</h2>{video.payload.scenes?.map((scene)=> <section><h3>{scene.overlay_text ?? `Scene ${scene.index}`}</h3><p>{scene.narration}</p></section>)}{video.payload.transcript&&<p>{video.payload.transcript}</p>}</article></BaseLayout>
