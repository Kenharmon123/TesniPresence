---
import BaseLayout from '../layouts/BaseLayout.astro'; import { activeDomain } from '../config/domains'; import { generalFaqs } from '../data/tesni'; import { breadcrumbs, faqPage } from '../lib/schema';
---
<BaseLayout title={`Business Lending FAQ | ${activeDomain.siteName}`} description="Answers to common questions about SBA loans, business lines of credit, commercial real estate financing, DSCR loans, and how the lending marketplace works." path="/faq" jsonLd={[breadcrumbs([['Home','/'],['FAQ','/faq']]),faqPage(generalFaqs)]}><section class="section faq"><div class="wrap"><h1>Business lending FAQ</h1><p class="lead">Common questions from business owners and real estate investors who work with {activeDomain.siteName}.</p>{generalFaqs.map(({q,a})=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section></BaseLayout>
