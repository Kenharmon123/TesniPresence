---
import '../styles/global.css';
import { activeDomain, absoluteUrl } from '../config/domains';
import Seo from '../components/Seo.astro';
export interface Props { title: string; description: string; path?: string; type?: 'website'|'article'; noindex?: boolean; jsonLd?: Record<string,unknown>[]; publishedTime?: string; modifiedTime?: string; }
const { title, description, path='/', type='website', noindex=false, jsonLd=[], publishedTime, modifiedTime } = Astro.props;
const nav = [['/services','Services'],['/locations','Locations'],['/blog','Insights'],['/podcast','Podcast'],['/faq','FAQ'],['/contact','Contact']];
const cssVars = `--primary:${activeDomain.brand.primary};--accent:${activeDomain.brand.accent};--ink:${activeDomain.brand.ink};--paper:${activeDomain.brand.paper}`;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="theme-color" content={activeDomain.brand.primary} /><Seo {title} {description} {path} {type} {noindex} {jsonLd} {publishedTime} {modifiedTime} />
{activeDomain.gaId && <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','${activeDomain.gaId}');`} />}</head>
<body style={cssVars}><a class="skip-link" href="#main-content">Skip to content</a><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/" aria-label={`${activeDomain.siteName} home`}><img src={activeDomain.logoPath} width="120" height="36" alt={activeDomain.siteName} /></a><nav aria-label="Primary"><ul>{nav.map(([href,label]) => <li><a href={href}>{label}</a></li>)}</ul></nav><a class="button small" href="/contact">Get started</a></div></header><main id="main-content"><slot /></main><footer class="site-footer"><div class="wrap footer-grid"><div><a class="footer-name" href="/">{activeDomain.siteName}</a><p>{activeDomain.description}</p></div><div><h2>Explore</h2><a href="/services">Services</a><a href="/locations">Locations</a><a href="/blog">Insights</a><a href="/faq">FAQ</a></div><div><h2>Contact</h2>{activeDomain.contact.phone && <a href={`tel:${activeDomain.contact.phoneHref}`}>{activeDomain.contact.phone}</a>}<a href={`mailto:${activeDomain.contact.email}`}>{activeDomain.contact.email}</a><a href="/contact">Request a consultation</a></div></div><div class="wrap legal"><p>{activeDomain.legalDisclaimer}</p><p>© {new Date().getFullYear()} {activeDomain.siteName}. All rights reserved. <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href={absoluteUrl('/rss.xml')}>RSS</a></p></div></footer></body></html>
