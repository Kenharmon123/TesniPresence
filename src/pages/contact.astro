---
import BaseLayout from '../layouts/BaseLayout.astro'; import LeadForm from '../components/LeadForm.astro'; import { activeDomain } from '../config/domains'; import { breadcrumbs } from '../lib/schema';
---
<BaseLayout title={`Contact ${activeDomain.siteName} | Business Lending Consultations`} description={`Talk with ${activeDomain.siteName} about SBA loans, business lines of credit, and commercial real estate financing.`} path="/contact" jsonLd={[breadcrumbs([['Home','/'],['Contact','/contact']])]}><section class="section"><div class="wrap grid two"><div><p class="eyebrow">Contact</p><h1>Talk through your financing project</h1><p class="lead">Tell us about your business, project, and timeline. Sharing initial information does not authorize a credit pull and creates no obligation to apply.</p>{activeDomain.contact.phone&&<p><strong>Phone</strong><br/><a href={`tel:${activeDomain.contact.phoneHref}`}>{activeDomain.contact.phone}</a><br/><span class="muted">Monday–Friday, 8 a.m. to 6 p.m. Central</span></p>}<p><strong>Email</strong><br/><a href={`mailto:${activeDomain.contact.email}`}>{activeDomain.contact.email}</a></p></div><LeadForm /></div></section></BaseLayout>
