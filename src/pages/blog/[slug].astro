---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { activeDomain, absoluteUrl } from '../../config/domains'; import { getPublishedArticles, getArticleBySlug, getRelatedArticles } from '../../lib/content'; import { articleSchema, breadcrumbs, faqPage } from '../../lib/schema';
export async function getStaticPaths(){const articles=await getPublishedArticles();return articles.map((article)=>({params:{slug:article.slug}}));}
const article = await getArticleBySlug(Astro.params.slug ?? ''); if (!article) return Astro.redirect('/404'); const path=`/blog/${article.slug}`; const related=await getRelatedArticles(article); const reading=Math.max(1,Math.ceil(article.body.split(/\s+/).length/220)); const supplied=article.payload.schema_jsonld ? [article.payload.schema_jsonld] : []; const faq=article.payload.faq?.length ? [faqPage(article.payload.faq)] : [];
---
<BaseLayout title={article.payload.meta_title ?? `${article.title} | ${activeDomain.siteName}`} description={article.payload.meta_description ?? article.summary} {path} type="article" publishedTime={article.publishedAt} modifiedTime={article.updatedAt} jsonLd={[breadcrumbs([['Home','/'],['Blog','/blog'],[article.title,path]]),articleSchema(article.title,article.summary,path,article.publishedAt,article.updatedAt),...supplied,...faq]}><article class="prose"><p class="crumbs"><a href="/blog">Insights</a> / {article.campaignName ?? 'Article'}</p><h1>{article.title}</h1><p class="meta">{new Date(article.publishedAt).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})} · {reading} min read</p>{article.payload.dek&&<p class="lead">{article.payload.dek}</p>}{article.payload.sections?.map((section)=> <section><h2>{section.heading}</h2><p>{section.body}</p></section>)}{!article.payload.sections?.length && article.body.split('\n\n').map((paragraph)=><p>{paragraph}</p>)}{article.payload.key_takeaways?.length ? <section><h2>Key takeaways</h2><ul>{article.payload.key_takeaways.map((point)=><li>{point}</li>)}</ul></section>:null}{article.payload.faq?.length ? <section class="faq"><h2>Questions readers ask</h2>{article.payload.faq.map(({q,a})=><details><summary>{q}</summary><p>{a}</p></details>)}</section>:null}<p class="fine-print">This article is for general information and does not constitute financial, legal, or tax advice. {activeDomain.legalDisclaimer}</p>{related.length ? <section><h2>Related articles</h2><ul>{related.map((item)=><li><a href={`/blog/${item.slug}`}>{item.title}</a></li>)}</ul></section>:null}<link rel="alternate" type="application/rss+xml" title={`${activeDomain.siteName} RSS`} href={absoluteUrl('/rss.xml')} /></article></BaseLayout>
